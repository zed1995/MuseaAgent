# Database
MUSEA_AGENT_DATABASE__URL=postgresql+psycopg://postgres:postgres@localhost:5432/musea_agent
MUSEA_AGENT_DATABASE__ECHO=false

# App
MUSEA_AGENT_ENVIRONMENT=development

# Indexing — model adapters (all mock by default, zero real API calls)
# Set mock_* = false to use real OpenAI-compatible model calls
MUSEA_AGENT_INDEXING__MOCK_TRANSLATION=true
MUSEA_AGENT_INDEXING__MOCK_ENRICHMENT=true
MUSEA_AGENT_INDEXING__MOCK_EMBEDDING=true

# Model selection (used when mock_* = false)
# MUSEA_AGENT_INDEXING__TRANSLATION_MODEL=gpt-4o-mini
# MUSEA_AGENT_INDEXING__ENRICHMENT_MODEL=gpt-4o
# MUSEA_AGENT_INDEXING__EMBEDDING_MODEL=text-embedding-3-small

# API connection (required when mock_* = false)
# MUSEA_AGENT_INDEXING__OPENAI_API_KEY=sk-...
# MUSEA_AGENT_INDEXING__OPENAI_BASE_URL=https://api.openai.com/v1
