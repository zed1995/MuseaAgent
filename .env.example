# Database
MUSEA_AGENT_DATABASE__URL=postgresql+psycopg://postgres:postgres@localhost:5432/musea_agent
MUSEA_AGENT_DATABASE__ECHO=false

# App
MUSEA_AGENT_ENVIRONMENT=development

# Retrieval / debug surface
MUSEA_AGENT_RETRIEVAL__ENABLE_DEBUG_ENDPOINT=false

# Indexing — model adapters (all mock by default, zero real API calls)
MUSEA_AGENT_INDEXING__MOCK_TRANSLATION=true
MUSEA_AGENT_INDEXING__MOCK_ENRICHMENT=false
MUSEA_AGENT_INDEXING__MOCK_EMBEDDING=false

# Enrichment model (vision model for image understanding)
MUSEA_AGENT_INDEXING__ENRICHMENT_MODEL=google/gemini-2.5-flash-lite-001

# Embedding model (OpenRouter model ID)
MUSEA_AGENT_INDEXING__EMBEDDING_MODEL=openai/text-embedding-3-small

# API connection — OpenRouter handles both vision + embedding
MUSEA_AGENT_INDEXING__OPENAI_API_KEY=sk-or-...
MUSEA_AGENT_INDEXING__OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Separate embedding API config (leave empty to use openai_* above)
# MUSEA_AGENT_INDEXING__EMBEDDING_API_KEY=
# MUSEA_AGENT_INDEXING__EMBEDDING_BASE_URL=

# LangChain capability layer — these drive retrieval preparation + agent nodes.
# If you want the new capability layer to use OpenRouter, configure the
# provider/model/api_key/base_url explicitly here.
MUSEA_AGENT_LLM__UNDERSTANDING__PROVIDER=openrouter
MUSEA_AGENT_LLM__UNDERSTANDING__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__UNDERSTANDING__API_KEY=sk-or-...
MUSEA_AGENT_LLM__UNDERSTANDING__BASE_URL=https://openrouter.ai/api/v1

MUSEA_AGENT_LLM__REWRITE__PROVIDER=openrouter
MUSEA_AGENT_LLM__REWRITE__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__REWRITE__API_KEY=sk-or-...
MUSEA_AGENT_LLM__REWRITE__BASE_URL=https://openrouter.ai/api/v1

MUSEA_AGENT_LLM__INTENT__PROVIDER=openrouter
MUSEA_AGENT_LLM__INTENT__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__INTENT__API_KEY=sk-or-...
MUSEA_AGENT_LLM__INTENT__BASE_URL=https://openrouter.ai/api/v1

MUSEA_AGENT_LLM__PLANNER__PROVIDER=openrouter
MUSEA_AGENT_LLM__PLANNER__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__PLANNER__API_KEY=sk-or-...
MUSEA_AGENT_LLM__PLANNER__BASE_URL=https://openrouter.ai/api/v1

MUSEA_AGENT_LLM__CRITIC__PROVIDER=openrouter
MUSEA_AGENT_LLM__CRITIC__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__CRITIC__API_KEY=sk-or-...
MUSEA_AGENT_LLM__CRITIC__BASE_URL=https://openrouter.ai/api/v1

MUSEA_AGENT_LLM__RESPONSE__PROVIDER=openrouter
MUSEA_AGENT_LLM__RESPONSE__MODEL=google/gemini-2.5-flash-lite
MUSEA_AGENT_LLM__RESPONSE__API_KEY=sk-or-...
MUSEA_AGENT_LLM__RESPONSE__BASE_URL=https://openrouter.ai/api/v1
